<mvc:View controllerName="skillmatrixui.controller.Administration"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:table="sap.ui.table"
    xmlns:micro="sap.suite.ui.microchart"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable">
    <Page id="adminPage"
        showHeader="false">
        <IconTabBar id="idIconTabBarMulti"
            expanded="{device>/isNoPhone}"
            class="sapUiResponsiveContentPadding">
            <items>
                <IconTabFilter icon="sap-icon://attachment"
                    key="attachments">
                    <smartTable:SmartTable id="stSkills"
                        entitySet="Skills"
                        tableType="ResponsiveTable"
                        enableExport="true"
                        enableAutoBinding="true"
                        useVariantManagement="false"
                        header="{i18n>SkillsTable}"
                        useTablePersonalisation="true"
                        beforeRebindTable="onBeforeSkills"
                        initialise="onInitTeamRates"
                        showRowCount="true"
                        class="sapUiResponsiveContentPadding"
                        enableAutoColumnWidth="true"
                        editTogglable="false">
                        <Table mode="MultiSelect"
                            growingThreshold="100"
                            growing="true"
                            growingScrollToLoad="true">
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="{i18n>Skills}" />
                                    <ToolbarSpacer />
                                    <OverflowToolbarButton icon="sap-icon://add"
                                        press="onAddSkill" />
                                    <OverflowToolbarButton icon="sap-icon://delete"
                                        press="onDeleteSkill" />
                                </OverflowToolbar>
                            </headerToolbar>
                        </Table>
                    </smartTable:SmartTable>

                </IconTabFilter>
                <IconTabFilter icon="sap-icon://group"
                    key="people">
                    <smartTable:SmartTable id="stPersonnels"
                        entitySet="Personnels"
                        tableType="ResponsiveTable"
                        enableExport="true"
                        enableAutoBinding="true"
                        useVariantManagement="false"
                        header="{i18n>PersonnelsTable}"
                        useTablePersonalisation="true"
                        beforeRebindTable="onBeforeSkills"
                        initialise="onInitTeamRates"
                        showRowCount="true"
                        class="sapUiResponsiveContentPadding"
                        enableAutoColumnWidth="true"
                        editTogglable="false">
                        <Table mode="MultiSelect"
                            growingThreshold="100"
                            growing="true"
                            growingScrollToLoad="true">
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="{i18n>mappingItems}" />
                                    <ToolbarSpacer />
                                    <OverflowToolbarButton icon="sap-icon://add"
                                        press="onAddPersonnel" />
                                    <OverflowToolbarButton icon="sap-icon://delete"
                                        press="onDeletePersonnel" />
                                </OverflowToolbar>
                            </headerToolbar>
                        </Table>

                    </smartTable:SmartTable>
                </IconTabFilter>
            </items>
        </IconTabBar>
    </Page>
</mvc:View>
